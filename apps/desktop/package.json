{
  "name": "@kovan/desktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/build-dictate.mjs && electron-vite dev",
    "build": "node scripts/build-dictate.mjs && electron-vite build",
    "start": "electron-vite preview",
    "pack": "node scripts/build-dictate.mjs && electron-vite build && electron-builder --dir",
    "dist": "node scripts/build-dictate.mjs && electron-vite build && electron-builder --mac --arm64",
    "smoke": "node scripts/build-dictate.mjs && electron-vite build && KOVAN_SMOKE=1 electron .",
    "smoke:seeded": "node scripts/build-dictate.mjs && electron-vite build && KOVAN_SMOKE=seeded electron .",
    "smoke:live": "node scripts/build-dictate.mjs && electron-vite build && KOVAN_SMOKE=live electron .",
    "typecheck": "tsc --noEmit",
    "install:app": "npm run dist && node ../../scripts/install-app.mjs",
    "smoke:workspace": "node scripts/build-dictate.mjs && electron-vite build && KOVAN_SMOKE=workspace electron ."
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "dompurify": "^3.4.15",
    "highlight.js": "^11.12.0",
    "marked": "^14.1.4",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@kovan/agent": "*",
    "@kovan/core": "*",
    "@kovan/git": "*",
    "@kovan/host": "*",
    "@kovan/providers": "*",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.5.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11"
  },
  "productName": "Kovan",
  "build": {
    "appId": "com.idrisay.kovan",
    "productName": "Kovan",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!**/*.map",
      "!resources/alternatives/**",
      "!**/node_modules/node-pty/prebuilds/darwin-x64/**",
      "!**/node_modules/node-pty/prebuilds/win32-*/**",
      "!**/node_modules/node-pty/build/node_gyp_bins/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "resources/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSUserNotificationAlertStyle": "banner",
        "NSMicrophoneUsageDescription": "Kovan listens only while you dictate: double-tap ⌘ to start, and again to stop.",
        "NSSpeechRecognitionUsageDescription": "Kovan turns what you dictate into text on this Mac."
      },
      "extraResources": [
        {
          "from": "resources/trayTemplate.png",
          "to": "trayTemplate.png"
        },
        {
          "from": "resources/trayTemplate@2x.png",
          "to": "trayTemplate@2x.png"
        },
        {
          "from": "resources/bin/kovan-dictate",
          "to": "bin/kovan-dictate"
        },
        {
          "from": "resources/claude-mod",
          "to": "claude-mod",
          "filter": ["**/*", "!**/tests/**", "!**/.claude-plugin/types/**", "!**/tsconfig.json"]
        }
      ]
    },
    "electronVersion": "44.5.1",
    "asarUnpack": [
      "**/node_modules/node-pty/**",
      "out/main/ptyHost.mjs"
    ],
    "npmRebuild": true,
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Development",
      "icon": "resources/icon.png",
      "executableName": "kovan",
      "synopsis": "What is blocked on you, handed to a coding agent",
      "maintainer": "idrisay <idrisaydev@gmail.com>",
      "extraResources": [
        {
          "from": "resources/trayLinux.png",
          "to": "trayLinux.png"
        },
        {
          "from": "resources/icon.png",
          "to": "icon.png"
        },
        {
          "from": "resources/claude-mod",
          "to": "claude-mod",
          "filter": ["**/*", "!**/tests/**", "!**/.claude-plugin/types/**", "!**/tsconfig.json"]
        }
      ],
      "artifactName": "Kovan-${version}-${arch}.${ext}"
    },
    "deb": {
      "depends": [
        "libsecret-1-0",
        "libnotify4",
        "libxss1",
        "libnss3",
        "libgbm1",
        "libasound2 | libasound2t64"
      ],
      "packageName": "kovan"
    }
  },
  "description": "Tells you what is blocked on you, and hands it to a coding agent.",
  "author": {
    "name": "idrisay",
    "email": "idrisaydev@gmail.com"
  },
  "homepage": "https://kovan.idrisay.ch"
}
