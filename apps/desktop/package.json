{
  "name": "@baton/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "pack": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder --mac --arm64",
    "smoke": "electron-vite build && BATON_SMOKE=1 electron .",
    "smoke:seeded": "electron-vite build && BATON_SMOKE=seeded electron .",
    "smoke:live": "electron-vite build && BATON_SMOKE=live electron .",
    "typecheck": "tsc --noEmit",
    "install:app": "npm run dist && node ../../scripts/install-app.mjs",
    "smoke:workspace": "electron-vite build && BATON_SMOKE=workspace electron ."
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "dompurify": "^3.4.15",
    "highlight.js": "^11.12.0",
    "marked": "^14.1.4",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@baton/agent": "*",
    "@baton/core": "*",
    "@baton/git": "*",
    "@baton/host": "*",
    "@baton/providers": "*",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11"
  },
  "productName": "Baton",
  "build": {
    "appId": "com.idrisay.baton",
    "productName": "Baton",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!**/*.map",
      "!resources/alternatives/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "resources/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSUserNotificationAlertStyle": "banner"
      }
    },
    "electronVersion": "33.4.11",
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "npmRebuild": true,
    "extraResources": [
      {
        "from": "resources/trayTemplate.png",
        "to": "trayTemplate.png"
      },
      {
        "from": "resources/trayTemplate@2x.png",
        "to": "trayTemplate@2x.png"
      }
    ]
  },
  "description": "Tells you what is blocked on you, and hands it to a coding agent.",
  "author": {
    "name": "idrisay",
    "email": "idrisaydev@gmail.com"
  }
}
